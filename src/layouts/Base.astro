---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Global Shipping Radar',
  description = 'Live global maritime logistics dashboard: container vessels, ports, routes and container tracking (simulated demo data).',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e6edf4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      // Apply the user's chosen theme before first paint to avoid a flash. The default is light;
      // a persisted theme only counts once the user picked it themselves (themeChosen).
      try {
        var raw = localStorage.getItem('gsr:settings:v1');
        var saved = raw ? JSON.parse(raw) : null;
        var theme = saved && saved.themeChosen ? saved.theme : null;
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#081320' : '#e6edf4');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
