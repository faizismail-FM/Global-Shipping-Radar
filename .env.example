# Global Shipping Radar — environment variables
# Copy this file to `.env` and adjust values. All variables are optional.
# Variables prefixed with PUBLIC_ are exposed to the browser by Astro.

# MapLibre style used for the dark theme. Must be a MapLibre-compatible style JSON URL.
# Defaults to the free, key-less CARTO "Dark Matter" style.
# Set to `local` to force the bundled offline fallback style (no network needed).
PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# MapLibre style used for the light theme.
# Defaults to the free, key-less CARTO "Positron" style.
PUBLIC_MAP_STYLE_URL_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Default simulation tick interval in milliseconds (user can change it in the UI).
PUBLIC_SIM_INTERVAL_MS=2000

# Vessel data source new visitors start with: `simulated` (built-in fleet),
# `digitraffic` (live AIS, Baltic Sea, no key) or `aisstream` (live AIS, global,
# needs AISSTREAM_API_KEY below).
PUBLIC_DEFAULT_DATA_SOURCE=simulated

# ---------------------------------------------------------------------------
# Server-only secrets (no PUBLIC_ prefix: never shipped to the browser).
# ---------------------------------------------------------------------------
# Free API key from https://aisstream.io — enables the "Global AIS" data source
# through the relay function at /api/ais/aisstream.
AISSTREAM_API_KEY=
# Override the AISStream WebSocket URL (only for local tests with scripts/mock-aisstream.mjs).
# AISSTREAM_WS_URL=ws://127.0.0.1:9123

# Hapag-Lloyd API Portal (https://api-portal.hlag.com): create an application,
# subscribe it to the "Track & Trace" product and paste its credentials here.
# Enables live container tracking for Hapag-Lloyd containers through the relay
# function at /api/containers/track. Leave empty to keep demo records only.
HLAG_CLIENT_ID=
HLAG_CLIENT_SECRET=
# Override the Hapag-Lloyd API base (only for local tests with scripts/mock-hlag.mjs).
# HLAG_API_BASE=http://127.0.0.1:9124/hlag/external/v2
