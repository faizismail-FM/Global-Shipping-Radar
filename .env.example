# Global Shipping Radar — environment variables
# Copy this file to `.env` and adjust values. All variables are optional.
# Variables prefixed with PUBLIC_ are exposed to the browser by Astro.

# MapLibre style used for the dark theme. Must be a MapLibre-compatible style JSON URL.
# Defaults to the free, key-less CARTO "Dark Matter" style.
# Set to `local` to force the bundled offline fallback style (no network needed).
PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# MapLibre style used for the light theme.
# Defaults to the free, key-less CARTO "Positron" style.
PUBLIC_MAP_STYLE_URL_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Default simulation tick interval in milliseconds (user can change it in the UI).
PUBLIC_SIM_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Reserved for future real-data providers. NOT used by the MVP.
# ---------------------------------------------------------------------------
# AIS_API_URL=
# AIS_API_KEY=
# CONTAINER_TRACKING_API_URL=
# CONTAINER_TRACKING_API_KEY=
