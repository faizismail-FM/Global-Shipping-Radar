{
  "name": "global-shipping-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Global Shipping Radar — a live, simulated global maritime logistics dashboard built with Astro, React, Tailwind CSS and MapLibre GL JS.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "data:world": "node scripts/prepare-world-data.mjs",
    "test:sim": "tsx scripts/soak-simulation.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "lucide-react": "^1.44.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
